#!/usr/bin/env bash
# Launch Hermes for ONE campaign, with the campaign's own directory as the
# working directory and every Loam artifact written inside it.
#
# Copy this script into a new, empty directory and run it from there:
#
#     mkdir -p ~/campaigns/my-campaign
#     cp <loam-repo>/run-campaign ~/campaigns/my-campaign/
#     cd ~/campaigns/my-campaign && ./run-campaign
#
# The campaign name is the directory name, so renaming or copying the directory
# starts a separate campaign. This script works from anywhere: it keeps
# LOAM_REPO for the adapter and generates a local plugin shim pointing at it,
# because Hermes discovers project plugins relative to the working directory.
#
# Startup runs a fail-closed readiness check: one real completion per configured
# model role (reasoner, subagents, tournament generation, tournament ranking) and
# one returned Aurora run_code probe with hostname, PBS job ID, and device pin. If
# the HPC server is stopped, it starts a one-node debug allocation and waits up
# to LOAM_HPC_WAIT_SECONDS (default 900). It never restarts a listening server.
# Set LOAM_SKIP_PREFLIGHT=1 only for focused launcher diagnostics, never for a
# scientific campaign.
set -euo pipefail

CAMPAIGN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Absolute, because the campaign directory may live anywhere. Run from inside a
# checkout, the checkout is used; a copied script needs LOAM_REPO set in the
# command environment. Inherited Loam state variables are deliberately ignored
# below so campaigns cannot contaminate one another.
if [[ -z "${LOAM_REPO:-}" && -f "$CAMPAIGN_DIR/.loam/adapters/hermes/plugin/__init__.py" ]]; then
  LOAM_REPO="$CAMPAIGN_DIR"
fi
LOAM_REPO="${LOAM_REPO:-}"
CAMPAIGN_NAME="$(basename "$CAMPAIGN_DIR")"
cd "$CAMPAIGN_DIR"

# A launch owns its state identity. Never inherit these from a parent shell.
unset LOAM_STATE_DIR LOAM_RUN_ID LOAM_PRE_LLM_EVERY LOAM_LEDGER_PATH \
  LOAM_PARENT_MEMORY_PATH LOAM_WORKFLOW_ID LOAM_PROFILE LOAM_CONFIG_PATH \
  HERMES_ACCEPT_HOOKS

if [[ ! -f "$LOAM_REPO/.loam/adapters/hermes/plugin/__init__.py" ]]; then
  echo "run-campaign: no Loam adapter under LOAM_REPO=$LOAM_REPO" >&2
  echo "  Set LOAM_REPO to the loam checkout and re-run." >&2
  exit 1
fi

# Hermes only loads project plugins from <cwd>/.hermes/plugins, so the campaign
# directory needs its own shim. It is regenerated each launch to stay in step
# with LOAM_REPO.
SHIM_DIR="$CAMPAIGN_DIR/.hermes/plugins/loam-hooks"
mkdir -p "$SHIM_DIR"
cat > "$SHIM_DIR/plugin.yaml" <<YAML
name: loam-hooks
version: "0.1.0"
description: Campaign shim for the .loam Hermes adapter in $LOAM_REPO
YAML
cat > "$SHIM_DIR/__init__.py" <<PY
"""Generated by run-campaign; loads the Loam adapter from the repo checkout."""

import importlib.util
from pathlib import Path

_ADAPTER = Path("$LOAM_REPO") / ".loam" / "adapters" / "hermes" / "plugin" / "__init__.py"
_SPEC = importlib.util.spec_from_file_location("loam_hermes_adapter", _ADAPTER)
if _SPEC is None or _SPEC.loader is None:
    raise ImportError(f"Unable to load Loam Hermes adapter at {_ADAPTER}")
_MODULE = importlib.util.module_from_spec(_SPEC)
_SPEC.loader.exec_module(_MODULE)
register = _MODULE.register
PY

export HERMES_ENABLE_PROJECT_PLUGINS=1
export LOAM_ENABLED="${LOAM_ENABLED:-1}"
# Each campaign gets its own Hermes home, assembled from the repo's shared one.
#
# Why not just share the repo home: Hermes scopes agent memory to HERMES_HOME
# (memory_tool.get_memory_dir() -> HERMES_HOME/memories, with no override), and
# memories/MEMORY.md is injected into the system prompt every session. A shared
# home therefore leaks campaign-specific findings into every other campaign and
# keeps injecting them after the campaign ends, and it outlives archiving a
# campaign's state -- which splits the reasoner's beliefs from the tournament
# state it is reasoning about. Config stays single-source (see below), so "one
# place to change the model, no per-campaign drift" still holds.
SHARED_HERMES_HOME="$LOAM_REPO/.hermes/.loam-home"
export HERMES_HOME="$CAMPAIGN_DIR/.hermes/home"
mkdir -p "$HERMES_HOME"

# config.yaml is COPIED, not linked: Hermes rewrites it in place (version bumps,
# onboarding flags) and an atomic temp+rename would replace a symlink with a
# regular file -- silently detaching this campaign from the shared config, or
# clobbering it. Copying each launch keeps one editable source of truth while a
# campaign-local rewrite stays campaign-local.
if [[ ! -f "$SHARED_HERMES_HOME/config.yaml" ]]; then
  echo "run-campaign: no Hermes config at $SHARED_HERMES_HOME/config.yaml" >&2
  exit 1
fi
cp "$SHARED_HERMES_HOME/config.yaml" "$HERMES_HOME/config.yaml"

# Register the checkout's skills/ tree in the shared library before the home is
# assembled. Hermes resolves `campaign.skills` names against the library, so a
# clone whose library lacks them fails inside a code-generator mid-round rather
# than here. Idempotent and stdlib-only, so every launch keeps the library in
# step with the checkout -- including skills a `git pull` just added. It never
# replaces a library entry it does not own, and a conflict there is not worth
# aborting a launch over, so this reports and continues.
if [[ -f "$LOAM_REPO/scripts/install_skills.py" ]]; then
  python3 "$LOAM_REPO/scripts/install_skills.py" \
    --repo "$LOAM_REPO" --hermes-home "$SHARED_HERMES_HOME" >/dev/null ||
    echo "run-campaign: some skills were not registered; run scripts/install_skills.py" >&2
fi

# Shared, read-mostly: credentials, persona, tool library, binaries, plugins.
for shared_entry in auth.json SOUL.md skills bin plugins hooks; do
  [[ -e "$SHARED_HERMES_HOME/$shared_entry" ]] &&
    ln -sfn "$SHARED_HERMES_HOME/$shared_entry" "$HERMES_HOME/$shared_entry"
done

# Per-campaign: memories, sessions, logs, cache. Anything else Hermes needs it
# creates on demand inside this home.
mkdir -p "$HERMES_HOME/memories" "$HERMES_HOME/memory" "$HERMES_HOME/sessions" \
  "$HERMES_HOME/logs" "$HERMES_HOME/cache"

# User preferences are genuinely global; campaign findings are not. USER.md is
# shared; MEMORY.md is deliberately NOT inherited, so each campaign keeps its own
# findings index and cannot be primed by another campaign's conclusions.
[[ -e "$SHARED_HERMES_HOME/memories/USER.md" ]] &&
  ln -sfn "$SHARED_HERMES_HOME/memories/USER.md" "$HERMES_HOME/memories/USER.md"
# Everything Loam writes for this campaign: Jnana memory, tournament reports,
# the orchestration ledger and the run manifest. These values are assigned, not
# defaulted, so stale parent-shell state cannot redirect the run.
export LOAM_STATE_DIR="$CAMPAIGN_DIR/state"
export LOAM_PRE_LLM_EVERY=1
export LOAM_RUN_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
mkdir -p "$LOAM_STATE_DIR"

# Fail closed on actual inference and returned Aurora execution, not merely open
# TCP ports. When no HPC server exists, the preflight starts one bounded 1-node
# debug allocation and waits for it; it never restarts a listening server.
PREFLIGHT_PYTHON="${LOAM_PREFLIGHT_PYTHON:-$HOME/.loam-venv-312/bin/python}"
if [[ "${LOAM_SKIP_PREFLIGHT:-0}" != "1" ]]; then
  if [[ ! -x "$PREFLIGHT_PYTHON" ]]; then
    echo "run-campaign: preflight Python is unavailable: $PREFLIGHT_PYTHON" >&2
    exit 1
  fi
  # 300s per probe, not the script's 120s default: a just-built EL cluster is
  # slow on its first task (a trivial run_code measured 138s right after a
  # rebuild), so at 120s the readiness check would fail on a perfectly good
  # cold endpoint and abort the launch. This bounds a single probe; the wait for
  # the PBS job itself is --wait-seconds above.
  "$PREFLIGHT_PYTHON" "$LOAM_REPO/scripts/campaign_preflight.py" \
    --repo "$LOAM_REPO" \
    --hermes-home "$HERMES_HOME" \
    --wait-seconds "${LOAM_HPC_WAIT_SECONDS:-900}" \
    --timeout "${LOAM_PREFLIGHT_TIMEOUT:-300}" \
    >"$LOAM_STATE_DIR/preflight.json"
fi

echo "run-campaign: campaign '$CAMPAIGN_NAME'" >&2
echo "  state:  $LOAM_STATE_DIR" >&2
echo "  loam:   $LOAM_REPO" >&2
echo "  hermes: $HERMES_HOME" >&2
exec hermes "$@"
