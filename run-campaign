#!/usr/bin/env bash
# Launch Hermes for ONE campaign, with the campaign's own directory as the
# working directory and every Loam artifact written inside it.
#
# Copy this script into a new, empty directory and run it from there:
#
#     mkdir -p ~/campaigns/my-campaign
#     cp <loam-repo>/run-campaign ~/campaigns/my-campaign/
#     cd ~/campaigns/my-campaign && ./run-campaign
#
# The campaign name is the directory name, so renaming or copying the directory
# starts a separate campaign. This script works from anywhere: it keeps
# LOAM_REPO for the adapter and generates a local plugin shim pointing at it,
# because Hermes discovers project plugins relative to the working directory.
#
# Startup runs a fail-closed readiness check: one real completion per configured
# model role (reasoner, subagents, tournament generation, tournament ranking) and
# one returned Aurora run_code probe with hostname, PBS job ID, and device pin. It
# starts the local inference proxy if nothing is listening, and -- if the HPC
# server is stopped -- a one-node debug allocation. It never restarts a listening
# server.
#
# ----------------------------------------------------------------------------
# Environment
#
# Everything a campaign needs comes from files, not variables: the profile at
# ~/.hermes/loam.yaml, the goal and rules it names, and the Hermes config in the
# shared home. The variables below only change HOW this launch runs.
#
# Read by this script:
#   LOAM_REPO              the loam checkout, for the adapter and the skills
#                          tree. Defaults to this directory when the script sits
#                          in a checkout; a COPIED script must be given it.
#   LOAM_SKIP_PREFLIGHT=1  skip the readiness gate. This also skips the two
#                          auto-starts the gate performs -- the inference proxy
#                          and the HPC allocation -- so nothing brings them up.
#                          Launcher diagnostics only, never a scientific campaign.
#   LOAM_PREFLIGHT_PYTHON  interpreter for the preflight. Default
#                          ~/.loam-venv-312/bin/python; the launch fails if it
#                          is not executable.
#   LOAM_PREFLIGHT_TIMEOUT seconds per readiness probe (default 300; the script
#                          raises the preflight's own 120 because a freshly
#                          built EL cluster is slow on its first task).
#   LOAM_HPC_WAIT_SECONDS  how long to wait for a started allocation to listen
#                          (default 900).
#   LOAM_ENABLED           defaults to 1. Set 0 to launch Hermes with the Loam
#                          plugin inert.
#   LOAM_NOTIFY_CMD        read by the DRIVER (see below), not by this script:
#                          a command it appends a one-line JSON-quoted message
#                          to after each round and at stop. Unset: silent.
#
# Modes:
#   ./run-campaign           interactive Hermes; type `continue` to advance a round.
#   ./drive-campaign [opts]  unattended. The driver runs THIS script inside a
#                            pseudo-terminal and types for you, because a
#                            campaign cannot be driven by `hermes -z`: the
#                            dispatch tool needs a parent-agent context oneshot
#                            never creates, and a top-level delegation is
#                            backgrounded, so the turn would exit while its
#                            validators ran. `./drive-campaign --help` lists its
#                            budgets and stop conditions.
#
# Passed through to the preflight (see scripts/campaign_preflight.py):
#   ALCF_PROXY=0           do not auto-start the local inference proxy.
#   ALCF_PROXY_PORT        proxy port (default 51911).
#   ALCF_PROXY_PYTHON      proxy interpreter (default ~/.loam-venv-312).
#   ALCF_PROXY_LOG         proxy log (default ~/.loam-hpc/alcf_proxy_minerva.log).
#   HPC_ENV_FILE           the env file the HPC auto-start sources. Defaults to
#                          skills/hpc-deployment/set_env.sh, which is NOT the
#                          set_env_akv.sh that ONBOARDING tells you to edit --
#                          set this if you edited the other one.
#
# Assigned here, and an inherited value is DISCARDED, so a parent shell cannot
# redirect or merge a run: LOAM_STATE_DIR (always <campaign>/state), LOAM_RUN_ID
# (fresh per launch), LOAM_LEDGER_PATH, LOAM_PARENT_MEMORY_PATH,
# LOAM_WORKFLOW_ID, LOAM_PROFILE, HERMES_ACCEPT_HOOKS,
# HERMES_ENABLE_PROJECT_PLUGINS (=1; without it Hermes ignores the shim and no
# hook fires at all),
# HERMES_HOME (always <campaign>/.hermes/home).
#
# LOAM_CONFIG_PATH is the one exception: an inherited value is kept, but a
# campaign-local <campaign>/.hermes/home/loam.yaml overrides it when present,
# so the profile travels with the campaign rather than with the machine.
#
# Deliberately NOT a knob: the tournament cadence. LOAM_PRE_LLM_EVERY is read
# only by the emergency no-config path, so with a real profile it does nothing;
# set `pre_llm_every` in the profile instead. Likewise the active profile is
# chosen by `active_profile` in loam.yaml, not by LOAM_PROFILE, which is unset
# above.
# ----------------------------------------------------------------------------
set -euo pipefail

CAMPAIGN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Absolute, because the campaign directory may live anywhere. Run from inside a
# checkout, the checkout is used; a copied script needs LOAM_REPO set in the
# command environment. Inherited Loam state variables are deliberately ignored
# below so campaigns cannot contaminate one another.
if [[ -z "${LOAM_REPO:-}" && -f "$CAMPAIGN_DIR/.loam/adapters/hermes/plugin/__init__.py" ]]; then
  LOAM_REPO="$CAMPAIGN_DIR"
fi
LOAM_REPO="${LOAM_REPO:-}"
CAMPAIGN_NAME="$(basename "$CAMPAIGN_DIR")"
cd "$CAMPAIGN_DIR"

# A launch owns its state identity. Never inherit these from a parent shell.
unset LOAM_STATE_DIR LOAM_RUN_ID LOAM_PRE_LLM_EVERY LOAM_LEDGER_PATH \
  LOAM_PARENT_MEMORY_PATH LOAM_WORKFLOW_ID LOAM_PROFILE \
  HERMES_ACCEPT_HOOKS

# A campaign may carry its own profile, the way it already carries its own state
# directory and Hermes home. When it does, it wins -- so switching campaigns is
# `cd`, not editing a global file, and two campaigns cannot read each other's
# tournament settings. LOAM_CONFIG_PATH is therefore NOT in the unset list above;
# an inherited value still loses to a campaign-local file, which is what makes
# this safe to export from a wrapper. scripts/drive_campaign.py resolves the
# same paths in the same order for its own in-process profile read, so the driver
# and the hooks never disagree about which profile is live.
#
# Preferred layout: loam.yaml at the campaign ROOT (beside run-campaign), so
# dropping it in is all the setup a campaign needs. The legacy
# .hermes/home/loam.yaml location is still honored as a fallback.
for CAMPAIGN_PROFILE in "$CAMPAIGN_DIR/loam.yaml" "$CAMPAIGN_DIR/.hermes/home/loam.yaml"; do
  if [[ -f "$CAMPAIGN_PROFILE" ]]; then
    export LOAM_CONFIG_PATH="$CAMPAIGN_PROFILE"
    break
  fi
done

if [[ ! -f "$LOAM_REPO/.loam/adapters/hermes/plugin/__init__.py" ]]; then
  echo "run-campaign: no Loam adapter under LOAM_REPO=$LOAM_REPO" >&2
  echo "  Set LOAM_REPO to the loam checkout and re-run." >&2
  exit 1
fi

# Hermes only loads project plugins from <cwd>/.hermes/plugins, so the campaign
# directory needs its own shim. It is regenerated each launch to stay in step
# with LOAM_REPO.
SHIM_DIR="$CAMPAIGN_DIR/.hermes/plugins/loam-hooks"
mkdir -p "$SHIM_DIR"
cat > "$SHIM_DIR/plugin.yaml" <<YAML
name: loam-hooks
version: "0.1.0"
description: Campaign shim for the .loam Hermes adapter in $LOAM_REPO
YAML
cat > "$SHIM_DIR/__init__.py" <<PY
"""Generated by run-campaign; loads the Loam adapter from the repo checkout."""

import importlib.util
from pathlib import Path

_ADAPTER = Path("$LOAM_REPO") / ".loam" / "adapters" / "hermes" / "plugin" / "__init__.py"
_SPEC = importlib.util.spec_from_file_location("loam_hermes_adapter", _ADAPTER)
if _SPEC is None or _SPEC.loader is None:
    raise ImportError(f"Unable to load Loam Hermes adapter at {_ADAPTER}")
_MODULE = importlib.util.module_from_spec(_SPEC)
_SPEC.loader.exec_module(_MODULE)
register = _MODULE.register
PY

export HERMES_ENABLE_PROJECT_PLUGINS=1
export LOAM_ENABLED="${LOAM_ENABLED:-1}"
# Each campaign gets its own Hermes home, assembled from the repo's shared one.
#
# Why not just share the repo home: Hermes scopes agent memory to HERMES_HOME
# (memory_tool.get_memory_dir() -> HERMES_HOME/memories, with no override), and
# memories/MEMORY.md is injected into the system prompt every session. A shared
# home therefore leaks campaign-specific findings into every other campaign and
# keeps injecting them after the campaign ends, and it outlives archiving a
# campaign's state -- which splits the reasoner's beliefs from the tournament
# state it is reasoning about. Config stays single-source (see below), so "one
# place to change the model, no per-campaign drift" still holds.
SHARED_HERMES_HOME="$LOAM_REPO/.hermes/.loam-home"
export HERMES_HOME="$CAMPAIGN_DIR/.hermes/home"
mkdir -p "$HERMES_HOME"

# config.yaml is COPIED, not linked: Hermes rewrites it in place (version bumps,
# onboarding flags) and an atomic temp+rename would replace a symlink with a
# regular file -- silently detaching this campaign from the shared config, or
# clobbering it. Copying each launch keeps one editable source of truth while a
# campaign-local rewrite stays campaign-local.
#
# A campaign-local config.yaml, if present, is the source instead of the shared
# repo config, so per-campaign settings (e.g. a different delegation model) travel
# with the campaign rather than with the machine. Preferred layout: config.yaml at
# the campaign ROOT (beside loam.yaml and run-campaign), so dropping those two
# files in is all the setup a campaign needs. The legacy .hermes/config.yaml
# location is still honored, then the shared repo config as the final fallback.
# Whichever source is chosen is COPIED into the home each launch (Hermes rewrites
# home/config.yaml in place), so the root source stays a clean editable template.
for CONFIG_SOURCE in "$CAMPAIGN_DIR/config.yaml" "$CAMPAIGN_DIR/.hermes/config.yaml" "$SHARED_HERMES_HOME/config.yaml"; do
  [[ -f "$CONFIG_SOURCE" ]] && break
done
if [[ ! -f "$CONFIG_SOURCE" ]]; then
  echo "run-campaign: no Hermes config at $CAMPAIGN_DIR/config.yaml, $CAMPAIGN_DIR/.hermes/config.yaml, or $SHARED_HERMES_HOME/config.yaml" >&2
  exit 1
fi
cp "$CONFIG_SOURCE" "$HERMES_HOME/config.yaml"

# Register the checkout's skills/ tree in the shared library before the home is
# assembled. Hermes resolves `campaign.skills` names against the library, so a
# clone whose library lacks them fails inside a code-generator mid-round rather
# than here. Idempotent and stdlib-only, so every launch keeps the library in
# step with the checkout -- including skills a `git pull` just added. It never
# replaces a library entry it does not own, and a conflict there is not worth
# aborting a launch over, so this reports and continues.
if [[ -f "$LOAM_REPO/scripts/install_skills.py" ]]; then
  python3 "$LOAM_REPO/scripts/install_skills.py" \
    --repo "$LOAM_REPO" --hermes-home "$SHARED_HERMES_HOME" >/dev/null ||
    echo "run-campaign: some skills were not registered; run scripts/install_skills.py" >&2
fi

# Bake the LIVE allocation shape into the hpc-deployment skill so code-generators
# size run_batch batches to the real pool (nodes x 12 tiles / top_k concurrent
# code-gens), not the campaign goal's headline node count. Idempotent: rewrites
# one sentinel line. Uses the venv python (needs yaml + hpc_control); never fails
# the launch. The skill entry is a symlink into the repo, so resolve it first.
if [[ -f "$LOAM_REPO/scripts/fill_alloc_skill.py" ]]; then
  _hpc_skill="$SHARED_HERMES_HOME/skills/hpc-deployment/SKILL.md"
  _hpc_skill="$(readlink -f "$_hpc_skill" 2>/dev/null || echo "$_hpc_skill")"
  if [[ -f "$_hpc_skill" ]]; then
    "${LOAM_PREFLIGHT_PYTHON:-python3}" "$LOAM_REPO/scripts/fill_alloc_skill.py" "$_hpc_skill"       >/dev/null 2>&1 && echo "run-campaign: filled live allocation into hpc-deployment skill"       || echo "run-campaign: could not determine live allocation; hpc-deployment skill left generic" >&2
  fi
fi

# Shared, read-mostly: credentials, persona, tool library, binaries, plugins.
for shared_entry in auth.json SOUL.md skills bin plugins hooks; do
  [[ -e "$SHARED_HERMES_HOME/$shared_entry" ]] &&
    ln -sfn "$SHARED_HERMES_HOME/$shared_entry" "$HERMES_HOME/$shared_entry"
done

# Per-campaign: memories, sessions, logs, cache. Anything else Hermes needs it
# creates on demand inside this home.
mkdir -p "$HERMES_HOME/memories" "$HERMES_HOME/memory" "$HERMES_HOME/sessions" \
  "$HERMES_HOME/logs" "$HERMES_HOME/cache"

# User preferences are genuinely global; campaign findings are not. USER.md is
# shared; MEMORY.md is deliberately NOT inherited, so each campaign keeps its own
# findings index and cannot be primed by another campaign's conclusions.
[[ -e "$SHARED_HERMES_HOME/memories/USER.md" ]] &&
  ln -sfn "$SHARED_HERMES_HOME/memories/USER.md" "$HERMES_HOME/memories/USER.md"
# Everything Loam writes for this campaign: Jnana memory, tournament reports,
# the orchestration ledger and the run manifest. These values are assigned, not
# defaulted, so stale parent-shell state cannot redirect the run.
export LOAM_STATE_DIR="$CAMPAIGN_DIR/state"
export LOAM_RUN_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
# Only the emergency no-config path reads this; with a profile loaded, cadence
# comes from its `pre_llm_every`. Pinned to 1 so a campaign that somehow lands on
# that path still runs the tournament every turn rather than silently drifting to
# the built-in default.
export LOAM_PRE_LLM_EVERY=1
mkdir -p "$LOAM_STATE_DIR"

# Fail closed on actual inference and returned Aurora execution, not merely open
# TCP ports. When no HPC server exists, the preflight starts one bounded 1-node
# debug allocation and waits for it; it never restarts a listening server.
PREFLIGHT_PYTHON="${LOAM_PREFLIGHT_PYTHON:-$HOME/.loam-venv-312/bin/python}"
if [[ "${LOAM_SKIP_PREFLIGHT:-0}" != "1" ]]; then
  if [[ ! -x "$PREFLIGHT_PYTHON" ]]; then
    echo "run-campaign: preflight Python is unavailable: $PREFLIGHT_PYTHON" >&2
    exit 1
  fi
  # 300s per probe, not the script's 120s default: a just-built EL cluster is
  # slow on its first task (a trivial run_code measured 138s right after a
  # rebuild), so at 120s the readiness check would fail on a perfectly good
  # cold endpoint and abort the launch. This bounds a single probe; the wait for
  # the PBS job itself is --wait-seconds above.
  "$PREFLIGHT_PYTHON" "$LOAM_REPO/scripts/campaign_preflight.py" \
    --repo "$LOAM_REPO" \
    --hermes-home "$HERMES_HOME" \
    --wait-seconds "${LOAM_HPC_WAIT_SECONDS:-900}" \
    --timeout "${LOAM_PREFLIGHT_TIMEOUT:-300}" \
    >"$LOAM_STATE_DIR/preflight.json"
fi

echo "run-campaign: campaign '$CAMPAIGN_NAME'" >&2
echo "  state:  $LOAM_STATE_DIR" >&2
echo "  loam:   $LOAM_REPO" >&2
echo "  hermes: $HERMES_HOME" >&2
exec hermes "$@"
