+def _single_role_from_markers(task_list):
+    """The one ``[loam-agent-role=<role>]`` shared by every task in this call.
+
+    Loam stamps every delegated child's goal with a ``[loam-agent-role=<role>]``
+    marker (hypothesis_orchestration.py). Hermes collapses the task ``role``
+    field to leaf/orchestrator (_normalize_role), so that marker is the only
+    place the fine role (code-generator / hypothesis-validator / reasoner /
+    evidence-reviewer) survives to this point. Under Loam's delegation role gate
+    every task in one delegate_task call shares a role (a validator delegates
+    only code-generators), so a single role is resolvable; a mixed or unmarked
+    batch returns ``None``.
+    """
+    marker = "[loam-agent-role="
+    roles = set()
+    for t in task_list:
+        goal = (t.get("goal") or "") if isinstance(t, dict) else ""
+        start = goal.find(marker)
+        if start < 0:
+            continue
+        end = goal.find("]", start)
+        if end < 0:
+            continue
+        roles.add(goal[start + len(marker):end].strip())
+    return next(iter(roles)) if len(roles) == 1 else None
+
+
+# Credential keys a delegation.role_models mapping entry may override per role,
+# beyond the model itself. Anything here is fed through
+# _resolve_delegation_credentials exactly like the top-level delegation.* keys,
+# so api_mode auto-detection and provider resolution behave identically.
+_ROLE_ENDPOINT_KEYS = ("provider", "base_url", "api_key", "api_mode")
+
+
+def _role_override_entry(task_list, cfg: dict):
+    """The ``delegation.role_models`` entry for this call's role, or ``None``.
+
+    Returns the raw entry: a model string (legacy, model-only) or a mapping that
+    may ALSO carry provider/base_url/api_key/api_mode (per-role ENDPOINT split).
+    Inert unless ``role_models`` is configured and the call has a single
+    resolvable Loam role, so non-Loam delegations are unaffected.
+    """
+    role_models = cfg.get("role_models") if isinstance(cfg, dict) else None
+    if not isinstance(role_models, dict) or not role_models:
+        return None
+    role = _single_role_from_markers(task_list)
+    if role is None:
+        return None
+    return role_models.get(role)
+
+
+def _apply_role_override(creds: dict, entry, cfg: dict, parent_agent) -> dict:
+    """Fold a ``delegation.role_models`` entry into already-resolved ``creds``.
+
+    ``entry`` is either a model string (override just the model, reusing the
+    default delegation endpoint -- the original role_models behavior) or a
+    mapping. A mapping that sets only ``model`` behaves like the string form. A
+    mapping that also sets any of provider/base_url/api_key/api_mode re-resolves
+    the FULL credential bundle for that role via ``_resolve_delegation_credentials``,
+    so a single role (e.g. the code-generator) can run on a DIFFERENT endpoint
+    than ``delegation.*`` while every other role keeps the default. This is the
+    code-gen-model-isolation lever: hold the validator/reasoner on the default
+    model+endpoint and point only the code-generator at an ALCF cluster.
+
+    Raises ``ValueError`` if the role's endpoint cannot be resolved (propagated
+    to the caller as a tool_error).
+    """
+    if isinstance(entry, str):
+        model = entry.strip()
+        if model:
+            creds = dict(creds)
+            creds["model"] = model
+        return creds
+    if not isinstance(entry, dict):
+        return creds
+
+    def _clean(key):
+        val = entry.get(key)
+        return str(val).strip() if val is not None and str(val).strip() else None
+
+    if any(_clean(k) for k in _ROLE_ENDPOINT_KEYS):
+        # Inherit the top-level delegation.* fields, overlay the role's own, and
+        # re-resolve so base_url/provider/api_mode go through the same path as a
+        # top-level delegation endpoint.
+        role_cfg = {k: cfg.get(k) for k in ("model",) + _ROLE_ENDPOINT_KEYS}
+        for k in ("model",) + _ROLE_ENDPOINT_KEYS:
+            if _clean(k):
+                role_cfg[k] = _clean(k)
+        return _resolve_delegation_credentials(role_cfg, parent_agent)
+
+    model = _clean("model")
+    if model:
+        creds = dict(creds)
+        creds["model"] = model
+    return creds
+
+
 def _get_max_concurrent_children() -> int:
     """Read delegation.max_concurrent_children from config, falling back to
