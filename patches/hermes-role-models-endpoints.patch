+    # Loam per-role model/endpoint split: delegation.role_models[<role>], keyed
+    # by the [loam-agent-role=...] goal marker. A string overrides just the
+    # model (legacy); a mapping may ALSO carry provider/base_url/api_key/api_mode
+    # so ONE role runs on a different endpoint than delegation.* -- this is what
+    # isolates the code-generator on an ALCF cluster model while the
+    # hypothesis-validator / reasoner / evidence-reviewer stay on the default.
+    # The children are built from `creds` just below, so this feeds BOTH the
+    # synchronous and the background/async paths. Inert unless role_models is set.
+    _role_entry = _role_override_entry(task_list, cfg)
+    if _role_entry is not None:
+        try:
+            creds = _apply_role_override(creds, _role_entry, cfg, parent_agent)
+        except ValueError as exc:
+            return tool_error(
+                f"delegation.role_models endpoint resolution failed: {exc}"
+            )
+
