# Example Loam profile config. Copy to ~/.hermes/loam.yaml and edit every
# <PLACEHOLDER>. One active profile drives one campaign style. See ONBOARDING.md.
#
# This file is loaded from ~/.hermes/loam.yaml (OUTSIDE the repo); there is no
# tracked copy of the live file, so this .example is the template to plug in.

enabled: true
active_profile: my_campaign

profiles:
  my_campaign:
    enabled: true
    workflow_id: my_campaign
    # Absolute path. Lifecycle ledgers, run-manifest, Jnana memory and
    # tournament reports are written here. run-campaign overrides this with the
    # campaign directory's state/, so this value is the default for bare
    # run-hermes launches.
    state_dir: /ABS/PATH/TO/loam/.loam/state/my_campaign
    pre_llm_every: 1
    duplicate_policy: allow_and_audit

    hypothesis_orchestration:
      enabled: true

    hypothesis_tournament:
      enabled: true
      jnana_root: /ABS/PATH/TO/jnana
      provider: openai

      # Defaults below are the tournament JUDGE (ranking). A generation: block
      # overrides just that role and inherits everything else from here.
      inference_endpoint: http://127.0.0.1:51911/v1   # Minerva proxy (ranking)
      model: <RANKING_MODEL>                           # e.g. inkling-bf16

      generation:
        inference_endpoint: http://127.0.0.1:51900/v1  # Argo tunnel (generation)
        model: <GENERATION_MODEL>                       # e.g. argo:gpt-5.6-luna
        # Argo reasoning models reject temperature != 1 with HTTP 400; Jnana
        # sends 0.7 and swallows the per-worker error, so it looks like
        # "generated_hypotheses: 0" with status completed. This fixes it.
        omit_temperature: true

      # Reasoning models spend thousands of hidden tokens before any JSON; too
      # small truncates the ranking JSON and every match fails to parse. Lower
      # only for a non-reasoning model.
      json_max_tokens: 16384

      # Optional OKN knowledge-graph pre-pass before the first generation.
      knowledge:
        enabled: false

      state_file: /ABS/PATH/TO/loam/.loam/state/my_campaign/jnana-memory.json
      reports_dir: /ABS/PATH/TO/loam/.loam/state/my_campaign/tournament-reports
      initial_hypotheses: 50
      matches_per_run: 5      # pairwise ranking matches per round
      top_k: 3                # hypotheses handed to validators per round
      timeout_seconds: 600

    execution:
      mode: remote_mcp                    # or: local (for CAMPAIGN_TEST.md)
      tool_name: mcp__hpc__run_code
      function_name: run_code
      endpoint: hpc-deployment
      input_schema: '{"payload": "str", "workdir": "str|None", "timeout": "float", "venv_path": "str|None"}'
      runtime: Aurora frameworks python 3.12 via EL
      workdir_root: /flare/<PROJECT>/<USER>/hpc-run/work
      # Handed verbatim to every code-generator child. The child runs on the
      # HPC node and cannot see local files, so the activation recipe and every
      # tool command must be self-contained here. Use run_code SYNCHRONOUSLY for
      # a decisive measurement; invoke tools as a bash activation + CLI call, not
      # by importing them as a library. Fetch published reference data at run
      # time rather than pasting it from memory.
      setup: |
        Run every tool by activating its venv in a bash command inside run_code
        (subprocess.run(["bash","-lc", CMD])), never by importing it as a Python
        library. Absolute paths only; the working directory is not the project root.

        <Add your tool activation recipes here, e.g. the Chai-1 fold command and
        its venv, the ProteinMPNN activation, etc. Verify each returns rc=0 on a
        smoke input before trusting a campaign result.>

    # Optional Cairn tool-reputation integration (see docs/cairn.md). Cairn is
    # already on by default from .loam/cairn.json; a block here is optional and
    # replaces that default (use `enabled: false` to opt out). Carries paths and switches only, never secrets. read_side
    # changes agent behaviour; the write-side switches only observe. The project silo is
    # never set here: export CAIRN_PROJECT before launching Hermes, or Cairn sends nothing.
    # cairn:
    #   enabled: true
    #   base_url: https://api.cairnscore.ai
    #   key_file: ~/.cairn/keys/agent-loam.key
    #   auto_mint: true
    #   identity_prefix: agent://anl-loam/loam-
    #   read_side: true
    #   rate_agent_reports: true
    #   rate_hook_fallback: true
    #   auto_flush: true
    #   rate_roles: [code-generator, hypothesis-validator]
    #   timeout_seconds: 5
    #   entities:
    #     mcp://hpc#run_code: {task_tags: [code_exec]}
    #     tool://lammps: {patterns: [lmp, lammps], task_tags: [md_simulation]}
    #     tool://chai-1: {patterns: [chai], task_tags: [co_folding]}
