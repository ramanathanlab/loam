# Per-user Loam launcher settings. Copy to loam.env in your campaign directory
# (read by run-campaign) or at the repo root (read by run-hermes; gitignored).
# LOAM_ENV_FILE names another path. Variables already set in the calling
# environment take precedence.

# Your loam checkout (required by run-campaign, which runs from a campaign dir).
LOAM_REPO=/ABS/PATH/TO/loam

# Interpreter holding loam's dependencies (fastmcp, globus-compute-sdk,
# academy-py, pyyaml, aiohttp, alcf-tokens). Used for the campaign preflight and
# the ALCF inference proxy unless overridden below. Default: python3 on PATH.
LOAM_PYTHON=/ABS/PATH/TO/env/bin/python
# LOAM_PREFLIGHT_PYTHON=...   # override for the preflight only
# ALCF_PROXY_PYTHON=...       # override for the ALCF proxy only

# HPC MCP server settings (copy of skills/hpc-deployment/set_env.example.sh).
# Default: $LOAM_REPO/skills/hpc-deployment/set_env.local.sh
# HPC_ENV_FILE=/ABS/PATH/TO/set_env.local.sh

# ALCF Minerva proxy (Jnana ranking). Set ALCF_PROXY=0 to not start it.
# ALCF_PROXY_PORT=51911
# ALCF_PROXY_LOG=$HOME/.loam-hpc/alcf_proxy_minerva.log
