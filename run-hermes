#!/usr/bin/env bash
# Launch Hermes with this repository's Loam project plugin discoverable.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/." && pwd)"
cd "$ROOT"

export HERMES_ENABLE_PROJECT_PLUGINS=1
# The globally installed Loam plugin is inert unless a Loam activation variable
# is set. Keep this explicit for project-local launches.
export LOAM_ENABLED="${LOAM_ENABLED:-1}"
# Permit an isolated campaign to supply its own Hermes home/configuration.
export HERMES_HOME="${HERMES_HOME:-$ROOT/.hermes/.loam-home}"
# Invoke `.loam/hooks/pre-llm.py` every N turns of each Hermes session.
# Override at launch, e.g. `LOAM_PRE_LLM_EVERY=3 .loam/run-hermes`.
export LOAM_PRE_LLM_EVERY="${LOAM_PRE_LLM_EVERY:-1}"
# Route all Loam runtime artifacts for this invocation with, for example,
# `LOAM_STATE_DIR=/var/tmp/loam-run-42 .loam/run-hermes`.
export LOAM_STATE_DIR="${LOAM_STATE_DIR:-}"
export LOAM_RUN_ID="${LOAM_RUN_ID:-$(uuidgen | tr '[:upper:]' '[:lower:]')}"

# The model for Hermes (nemotron-3-ultra) and Jnana's tournament (gpt-oss-120b)
# is ALCF Minerva via scripts/alcf_inference_proxy.py. Argo is not used: its
# content filter drops henipavirus prompts (empty replies / HTTP 400).
# Starts the proxy if nothing is listening; detached, so it outlives Hermes.
# Skip with ALCF_PROXY=0 when using another provider via /model.
ALCF_PROXY_PORT="${ALCF_PROXY_PORT:-51911}"
ALCF_PROXY_PYTHON="${ALCF_PROXY_PYTHON:-$HOME/.loam-venv-312/bin/python}"
ALCF_PROXY_LOG="${ALCF_PROXY_LOG:-$HOME/.loam-hpc/alcf_proxy_minerva.log}"
if [[ "${ALCF_PROXY:-1}" != 0 ]] && ! nc -z 127.0.0.1 "$ALCF_PROXY_PORT" 2>/dev/null; then
  mkdir -p "$(dirname "$ALCF_PROXY_LOG")"
  ALCF_CLUSTER=minerva ALCF_PROXY_PORT="$ALCF_PROXY_PORT" \
    nohup "$ALCF_PROXY_PYTHON" "$ROOT/scripts/alcf_inference_proxy.py" >>"$ALCF_PROXY_LOG" 2>&1 </dev/null &
  disown
  for _ in $(seq 1 30); do
    nc -z 127.0.0.1 "$ALCF_PROXY_PORT" 2>/dev/null && break
    sleep 0.5
  done
  if ! nc -z 127.0.0.1 "$ALCF_PROXY_PORT" 2>/dev/null; then
    echo "run-hermes: ALCF proxy did not start on port $ALCF_PROXY_PORT; last log lines:" >&2
    tail -n 5 "$ALCF_PROXY_LOG" >&2
    echo "If it is an auth error: $(dirname "$ALCF_PROXY_PYTHON")/alcf-tokens login inference" >&2
    exit 1
  fi
  echo "run-hermes: started ALCF Minerva proxy on 127.0.0.1:$ALCF_PROXY_PORT (log $ALCF_PROXY_LOG)" >&2
fi

exec hermes "$@"
