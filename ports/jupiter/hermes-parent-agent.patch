new file mode 100644
index 0000000000..dc1bd31fc2
--- /dev/null
+++ b/agent/tool_call_context.py
@@ -0,0 +1,29 @@
+"""The agent owning a plugin tool dispatch, isolated across threads and tasks."""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from typing import Any, Iterator
+
+_CURRENT_TOOL_AGENT: ContextVar[Any] = ContextVar('current_tool_agent', default=None)
+
+
+def current_tool_agent() -> Any:
+    return _CURRENT_TOOL_AGENT.get()
+
+
+@contextmanager
+def tool_agent_scope(agent: Any) -> Iterator[None]:
+    token = _CURRENT_TOOL_AGENT.set(agent)
+    try:
+        yield
+    finally:
+        _CURRENT_TOOL_AGENT.reset(token)
+
+
+def dispatch_agent_tool(agent: Any, *args: Any, **kwargs: Any) -> Any:
+    """Keep nested plugin dispatch on the agent owning this registry call."""
+    import model_tools
+
+    with tool_agent_scope(agent):
+        return model_tools.handle_function_call(*args, **kwargs)
diff --git a/hermes_cli/plugins_tool_dispatch.py b/hermes_cli/plugins_tool_dispatch.py
new file mode 100644
index 0000000000..5818121dc7
--- /dev/null
+++ b/hermes_cli/plugins_tool_dispatch.py
@@ -0,0 +1,18 @@
+"""Resolve plugin dispatch parents from the executing session before the legacy CLI."""
+from __future__ import annotations
+
+from typing import Any
+
+from agent.tool_call_context import current_tool_agent
+
+
+def dispatch_plugin_tool(context: Any, tool_name: str, args: dict, **kwargs: Any) -> Any:
+    from tools.registry import registry
+
+    if "parent_agent" not in kwargs:
+        agent = current_tool_agent()
+        if agent is None:
+            agent = getattr(context._manager._cli_ref, "agent", None)
+        if agent is not None:
+            kwargs["parent_agent"] = agent
+    return registry.dispatch(tool_name, args, scope=context._manager.scope_key, **kwargs)
