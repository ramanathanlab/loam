@@ -0,0 +1,122 @@
+"""Gateway plugin delegation uses the calling agent rather than a shared CLI slot."""
+from concurrent.futures import ThreadPoolExecutor
+import json
+from threading import Barrier
+from types import SimpleNamespace
+
+import pytest
+
+from agent.agent_runtime_helpers import invoke_tool
+from agent.tool_call_context import current_tool_agent, tool_agent_scope
+from agent.tool_executor import _resolve_sequential_dispatch
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+from tools.registry import registry
+
+
+@pytest.fixture
+def plugin_dispatch(monkeypatch):
+    import tools.delegate_tool as delegation
+
+    manager = PluginManager()
+    manager._cli_ref = SimpleNamespace(agent=SimpleNamespace(session_id='unrelated-cli'))
+    context = PluginContext(PluginManifest(name='parent-context-probe', source='user'), manager)
+    barrier = Barrier(2)
+
+    def delegate(**kwargs):
+        parent = kwargs['parent_agent']
+        return json.dumps({'parent': parent.session_id, 'background': kwargs['background']})
+
+    def dispatch(args, **kwargs):
+        barrier.wait(timeout=10)
+        return context.dispatch_tool('delegate_task', {'goal': 'probe'})
+
+    monkeypatch.setattr(delegation, 'delegate_task', delegate)
+    registry.register(name='parent_context_probe', toolset='debugging',
+                      schema={'name': 'parent_context_probe', 'parameters': {'type': 'object'}},
+                      handler=dispatch)
+    yield context
+    registry.deregister('parent_context_probe')
+
+
+def _agent(session_id, depth):
+    return SimpleNamespace(session_id=session_id, _delegate_depth=depth,
+                           valid_tool_names=['parent_context_probe'], enabled_toolsets=None,
+                           disabled_toolsets=None, _context_engine_tool_names=set(),
+                           _memory_manager=None, quiet_mode=False)
+
+
+@pytest.mark.parametrize('path', ['concurrent', 'sequential'])
+def test_overlapping_gateway_plugin_calls_keep_their_own_parent(plugin_dispatch, path):
+    def call(index):
+        agent = _agent(f'conversation-{index}', index)
+        if path == 'concurrent':
+            result = invoke_tool(agent, 'parent_context_probe', {}, agent.session_id,
+                                 pre_tool_block_checked=True,
+                                 skip_tool_request_middleware=True,
+                                 skip_tool_execution_middleware=True)
+        else:
+            ref = SimpleNamespace(name='parent_context_probe', args={}, task_id=agent.session_id,
+                                  call_id=None, trace=[])
+            result = _resolve_sequential_dispatch(agent, ref, []).execute({})
+        assert current_tool_agent() is None
+        return json.loads(result)
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(call, [0, 1]))
+    assert results == [{'parent': 'conversation-0', 'background': True},
+                       {'parent': 'conversation-1', 'background': False}]
+
+
+def test_nested_agent_scope_restores_parent_after_failure():
+    parent, child = object(), object()
+    assert current_tool_agent() is None
+    with tool_agent_scope(parent):
+        with pytest.raises(RuntimeError), tool_agent_scope(child):
+            assert current_tool_agent() is child
+            raise RuntimeError('child tool failed')
+        assert current_tool_agent() is parent
+    assert current_tool_agent() is None
+
+
+def test_explicit_parent_overrides_ambient_agent(monkeypatch):
+    manager = PluginManager()
+    context = PluginContext(PluginManifest(name='explicit-parent-probe', source='user'), manager)
+    calls = []
+    monkeypatch.setattr(registry, 'dispatch', lambda name, args, **kwargs: calls.append(kwargs) or '{}')
+    explicit = object()
+    with tool_agent_scope(object()):
+        context.dispatch_tool('delegate_task', {}, parent_agent=explicit)
+    assert calls[0]['parent_agent'] is explicit
+
+
+def test_discovered_gateway_plugin_can_use_native_delegation(tmp_path, monkeypatch):
+    from hermes_cli import plugins
+    from hermes_cli.config import atomic_config_write
+
+    home = tmp_path / 'home'
+    plugin = home / 'plugins' / 'gateway-parent-probe'
+    plugin.mkdir(parents=True)
+    (plugin / 'plugin.yaml').write_text('name: gateway-parent-probe\nversion: "0.1.0"\n')
+    (plugin / '__init__.py').write_text(
+        'def register(ctx):\n'
+        '    ctx.register_tool(name="gateway_parent_list", toolset="debugging",\n'
+        '        schema={"name":"gateway_parent_list","parameters":{"type":"object"}},\n'
+        '        handler=lambda args, **kw: ctx.dispatch_tool("delegate_task", {"action":"list"}))\n'
+    )
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setattr(plugins, 'get_bundled_plugins_dir', lambda: tmp_path / 'no-bundled')
+    atomic_config_write(home / 'config.yaml', {'plugins': {'enabled': ['gateway-parent-probe']}})
+    manager = PluginManager()
+    try:
+        manager.discover_and_load()
+        assert manager._cli_ref is None
+        parent = _agent('native-gateway-parent', 0)
+        result = invoke_tool(parent, 'gateway_parent_list', {}, parent.session_id,
+                             pre_tool_block_checked=True, skip_tool_request_middleware=True,
+                             skip_tool_execution_middleware=True)
+        payload = json.loads(result)
+        assert payload['action'] == 'list'
+        assert isinstance(payload['subagents'], list)
+        assert current_tool_agent() is None
+    finally:
+        manager.unload()
