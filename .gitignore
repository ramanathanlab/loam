# Local Loam runtime state may contain delegated task text and summaries.
.loam/state/*
!.loam/state/README.md
.hermes/.loam-home/config_OLD.yaml
# Config backups and Hermes's corrupt-config copies can hold API keys.
.hermes/.loam-home/config.yaml.bak-*
.hermes/.loam-home/config.yaml.corrupt.*
# Editor swap files, bytecode, Hermes request dumps and curator tarballs.
*.swp
__pycache__/
*.pyc
.hermes/.loam-home/sessions/request_dump_*.json
.hermes/.loam-home/skills/.curator_backups/
# Hermes' own skill-registry state (taps, index cache, audit log), written
# whenever it reads the library. Not the library itself, which is tracked.
.hermes/.loam-home/skills/.hub/
*.lock

# --- Secrets: never track ---
# Hermes credentials. User-provided (created by `hermes` login); real keys must
# NOT live in git. See ONBOARDING.md and examples/hermes-config.yaml.example.
.hermes/**/auth.json
auth.json

# --- Hermes runtime home: keep the shared template (config.yaml, SOUL.md,
#     skills/, plugins/, hooks/, memories/USER.md), ignore per-run churn ---
.hermes/.loam-home/logs/
.hermes/.loam-home/cache/
.hermes/.loam-home/sessions/
.hermes/.loam-home/memory/
.hermes/.loam-home/hook_outputs/
.hermes/.loam-home/pastes/
.hermes/.loam-home/cron/
# Vendored pyright install (34 MB, plus a symlink into node_modules).
.hermes/.loam-home/lsp/
# Installed binaries: platform-specific, not source. tirith (sheeki03/tirith,
# AGPL-3.0) was tracked here as a 33 MB macOS arm64 build -- unusable on Linux
# or Aurora, and referenced by nothing in Loam. Install such tools yourself.
.hermes/.loam-home/bin/
.hermes/.loam-home/state.db
.hermes/.loam-home/state.db-shm
.hermes/.loam-home/state.db-wal
.hermes/.loam-home/verification_evidence.db
.hermes/.loam-home/processes.json
.hermes/.loam-home/interrupt_debug.log
.hermes/.loam-home/*.log
.hermes/.loam-home/*_cache.json
.hermes/.loam-home/models_dev_cache.json
.hermes/.loam-home/.hermes_history
.hermes/.loam-home/.update_check
.hermes/.loam-home/.skills_prompt_snapshot.json
.hermes/.loam-home/memories/MEMORY.md
.hermes/.loam-home/**/*.bak-*

# Per-campaign Hermes homes generated by run-campaign. The shim it writes lands
# in the CAMPAIGN directory, which is outside this repo, so there is nothing to
# ignore here: .hermes/plugins/loam-hooks/ is this repository's own tracked
# discovery shim, which run-hermes needs (Hermes only loads project plugins from
# <cwd>/.hermes/plugins). Do not add an ignore rule for it -- git cannot
# re-include files under an excluded directory, so the rule would only hide the
# shim from a fresh clone.
.hermes/home/

# Campaign runtime state written by the hooks.
loam_state/

# Python packaging / envs / OS cruft.
*.py[cod]
*.egg-info/
.loam-venv*/
.venv/
*.bak-*
.DS_Store

# Local working notes (see notes/README.md). Never part of the framework.
notes/
